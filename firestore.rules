rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function profilePath(uid) {
      return /databases/$(database)/documents/Users/$(uid);
    }

    function hasProfile() {
      return signedIn()
        && exists(profilePath(request.auth.uid));
    }

    function myProfile() {
      return get(profilePath(request.auth.uid)).data;
    }

    function isActiveAdmin() {
      return hasProfile()
        && myProfile().role == 'admin'
        && myProfile().status == 'active';
    }

    function isActiveStudent() {
      return hasProfile()
        && myProfile().status == 'active'
        && myProfile().role in ['student', 'siswa'];
    }

    function isMyGroup(groupId) {
      return isActiveStudent()
        && myProfile().groupId == groupId
        && exists(/databases/$(database)/documents/Groups/$(groupId))
        && request.auth.uid in get(
          /databases/$(database)/documents/Groups/$(groupId)
        ).data.memberUids;
    }

    // PROFIL AKUN
    // Registrasi publik langsung membuat profil siswa aktif tanpa persetujuan.
    // Role tetap siswa dan groupId wajib null; hanya admin yang dapat
    // menetapkan kelompok atau mengubah peran akun.
    match /Users/{uid} {
      allow read: if signedIn()
        && (request.auth.uid == uid || isActiveAdmin());

      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role in ['student', 'siswa']
        && request.resource.data.status == 'active'
        && request.resource.data.groupId == null;

      allow update: if isActiveAdmin()
        || (
          signedIn()
          && request.auth.uid == uid
          && resource.data.role in ['student', 'siswa']
          && resource.data.status == 'pending'
          && resource.data.groupId == null
          && request.resource.data.role == resource.data.role
          && request.resource.data.groupId == null
          && request.resource.data.status == 'active'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'updatedAt'])
        );
      allow delete: if isActiveAdmin();
    }

    // Kompatibilitas profil lama; pendaftaran baru menggunakan Users.
    match /users/{uid} {
      allow read: if signedIn()
        && (request.auth.uid == uid || isActiveAdmin());

      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role in ['student', 'siswa']
        && request.resource.data.status == 'active'
        && request.resource.data.groupId == null;

      allow update: if isActiveAdmin()
        || (
          signedIn()
          && request.auth.uid == uid
          && resource.data.role in ['student', 'siswa']
          && resource.data.status == 'pending'
          && resource.data.groupId == null
          && request.resource.data.role == resource.data.role
          && request.resource.data.groupId == null
          && request.resource.data.status == 'active'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'updatedAt'])
        );
      allow delete: if isActiveAdmin();
    }

    // KELOMPOK
    // Admin membuat kelompok dan menetapkan 3-4 siswa melalui dashboard.
    // Batas jumlah anggota ditegakkan di aplikasi admin; Rules juga
    // membatasi dokumen kelompok baru agar tidak dibuat oleh siswa.
    match /Groups/{groupId} {
      allow read: if isActiveAdmin()
        || (signedIn()
          && isActiveStudent()
          && request.auth.uid in resource.data.memberUids
          && myProfile().groupId == groupId);

      allow create: if isActiveAdmin()
        && request.resource.data.memberUids is list
        && request.resource.data.memberUids.size() >= 3
        && request.resource.data.memberUids.size() <= 4
        && request.resource.data.createdBy == request.auth.uid;

      allow update, delete: if isActiveAdmin();
    }

    // PRODUK USAHA
    // Admin tetap dapat mengelola seluruh data. Siswa aktif hanya dapat
    // membaca/membuat/mengubah/menghapus data milik kelompoknya sendiri.
    // Dokumen siswa wajib memiliki groupId dan createdBy.
    match /Products/{documentId} {
      allow read: if isActiveAdmin()
        || (resource.data.groupId is string && isMyGroup(resource.data.groupId));

      allow create: if isActiveAdmin()
        || (isActiveStudent()
          && request.resource.data.groupId is string
          && request.resource.data.groupId == myProfile().groupId
          && isMyGroup(request.resource.data.groupId)
          && request.resource.data.createdBy == request.auth.uid);

      allow update: if isActiveAdmin()
        || (resource.data.groupId is string
          && isMyGroup(resource.data.groupId)
          && request.resource.data.groupId == resource.data.groupId
          && request.resource.data.createdBy == resource.data.createdBy);

      allow delete: if isActiveAdmin()
        || (resource.data.groupId is string && isMyGroup(resource.data.groupId));
    }

    // PROMOSI DIGITAL
    match /Promotions/{documentId} {
      allow read: if isActiveAdmin()
        || (resource.data.groupId is string && isMyGroup(resource.data.groupId));

      allow create: if isActiveAdmin()
        || (isActiveStudent()
          && request.resource.data.groupId is string
          && request.resource.data.groupId == myProfile().groupId
          && isMyGroup(request.resource.data.groupId)
          && request.resource.data.createdBy == request.auth.uid);

      allow update: if isActiveAdmin()
        || (resource.data.groupId is string
          && isMyGroup(resource.data.groupId)
          && request.resource.data.groupId == resource.data.groupId
          && request.resource.data.createdBy == resource.data.createdBy);

      allow delete: if isActiveAdmin()
        || (resource.data.groupId is string && isMyGroup(resource.data.groupId));
    }

    // TRANSAKSI KEUANGAN
    match /Transactions/{documentId} {
      allow read: if isActiveAdmin()
        || (resource.data.groupId is string && isMyGroup(resource.data.groupId));

      allow create: if isActiveAdmin()
        || (isActiveStudent()
          && request.resource.data.groupId is string
          && request.resource.data.groupId == myProfile().groupId
          && isMyGroup(request.resource.data.groupId)
          && request.resource.data.createdBy == request.auth.uid);

      allow update: if isActiveAdmin()
        || (resource.data.groupId is string
          && isMyGroup(resource.data.groupId)
          && request.resource.data.groupId == resource.data.groupId
          && request.resource.data.createdBy == resource.data.createdBy);

      allow delete: if isActiveAdmin()
        || (resource.data.groupId is string && isMyGroup(resource.data.groupId));
    }

    // Tolak akses ke koleksi lain yang belum diberi aturan secara eksplisit.
  }
}
